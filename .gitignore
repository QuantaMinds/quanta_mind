# Environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/

# Build artefacts
dist/
build/
*.egg-info/
htmlcov/
.coverage

# Product output. The pack is derived from a commit and is rebuilt, never shared.
*.sqlite
*.sqlite3
packs/

# Phase 0 raw inputs are large and regenerated by the run. The *results* are
# committed on purpose -- PHASE0_RUNBOOK.md section 5 requires publishing them.
research/phase0/data/*
!research/phase0/data/.gitkeep

# The labelling sample: the human labels ARE the record and are committed, because the
# commit timestamp is what proves they predate the comparison. The key is sealed and the
# blind sheet is regenerated from the seed.
!research/phase0/data/labelling/
research/phase0/data/labelling/*
!research/phase0/data/labelling/human_labels.csv

# Editors and OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local-only Claude Code overrides. .claude/settings.json IS committed -- it is
# the enforcement layer described in CONTRIBUTING.md.
.claude/settings.local.json

# Sentinel created by hand to authorise one golden-file update. See
# scripts/guard/hook_pre_edit.py.
.quantamind-allow-golden

# Secrets. A GitHub token grants read access to the corpus under a real identity, and a
# token committed once is a token in the history forever -- rewriting it out is harder
# than never adding it. Listed BEFORE any such file was created, so there is no window
# in which one is committable.
.env
.env.*
*.token
secrets/

# Hook-written session records, regenerated every session
docs/plans/session-*.md
research/phase0/vertex/pr_corpus.json
research/phase0/vertex/vertex_cost.jsonl
research/phase0/vertex/run2.log
research/phase0/vertex/*.log
research/phase0/vertex/enriched_findings.jsonl
research/phase0/vertex/enriched_packet.json
research/phase0/vertex/rater2/
research/phase0/vertex/rater3/
research/phase0/vertex/symbol_findings.jsonl
research/phase0/vertex/symbol_packet.json
research/phase0/vertex/rater5/
